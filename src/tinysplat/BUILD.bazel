load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "cuda_build",
    define_values = {"cuda": "1"},
)

config_setting(
    name = "metal_build",
    define_values = {"metal": "1"},
)

cc_library(
    name = "tinysplat",
    srcs = [
        "gaussian_2d.cc",
        "gaussian_3d.cc",
        "image.cc",
        "parallel.cc",
    ] + select({
        ":cuda_build": ["gaussian_3d_cuda_bridge.cc"],
        "//conditions:default": [],
    }) + select({
        ":metal_build": ["gaussian_3d_metal_bridge.cc"],
        "//conditions:default": [],
    }),
    hdrs = [
        "include/tinysplat/gaussian_2d.h",
        "include/tinysplat/gaussian_3d.h",
        "include/tinysplat/image.h",
        "include/tinysplat/parallel.h",
        "include/tinysplat/sh.h",
        "include/tinysplat/types.h",
        "gaussian_3d_cuda_bridge.h",
        "gaussian_3d_metal_bridge.h",
    ],
    includes = ["include"],
    copts = ["-fopenmp"] + select({
        ":cuda_build": ["-DTINYSPLAT_CUDA"],
        "//conditions:default": [],
    }) + select({
        ":metal_build": ["-DTINYSPLAT_METAL"],
        "//conditions:default": [],
    }),
    linkopts = ["-fopenmp"] + select({
        ":cuda_build": ["-lcudart"],
        "//conditions:default": [],
    }) + select({
        ":metal_build": [
            "-framework",
            "Metal",
            "-framework",
            "Foundation",
        ],
        "//conditions:default": [],
    }),
    deps = select({
        ":cuda_build": [
            "//cuda:tinysplat_cuda",
            "//cuda:gaussian_2d_cuda_headers",
            "//cuda:gaussian_3d_cuda_headers",
        ],
        "//conditions:default": [],
    }) + select({
        ":metal_build": [
            "//metal:tinysplat_metal",
            "//metal:gaussian_3d_metal_headers",
        ],
        "//conditions:default": [],
    }),
)
