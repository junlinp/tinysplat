load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "metal_build",
    define_values = {"metal": "1"},
)

cc_library(
    name = "gaussian_3d_metal_headers",
    hdrs = ["include/tinysplat/gaussian_3d_metal.h"],
    includes = ["include"],
)

# Build Metal host with clang++ (Objective-C++) — runtime shader compile, no metallib needed.
genrule(
    name = "libtinysplat_metal",
    srcs = [
        "gaussian_3d_metal.mm",
        "include/tinysplat/gaussian_3d_metal.h",
    ],
    outs = ["libtinysplat_metal.a"],
    cmd = """
        set -e
        INC=$$(dirname $(location gaussian_3d_metal.mm))/include
        TMP=$$(mktemp -d)
        clang++ -std=c++17 -O3 -fobjc-arc -fPIC \
          -I$$INC \
          -c $(location gaussian_3d_metal.mm) -o $$TMP/metal.o
        ar rcs $@ $$TMP/metal.o
        rm -rf $$TMP
    """,
    tags = ["metal"],
    target_compatible_with = ["@platforms//os:macos"],
)

cc_import(
    name = "tinysplat_metal_import",
    static_library = ":libtinysplat_metal",
    tags = ["metal"],
)

cc_library(
    name = "tinysplat_metal",
    deps = [
        ":gaussian_3d_metal_headers",
        ":tinysplat_metal_import",
    ],
    linkopts = [
        "-framework",
        "Metal",
        "-framework",
        "Foundation",
    ],
    tags = ["metal"],
)
