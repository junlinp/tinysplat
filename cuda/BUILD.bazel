load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gaussian_2d_cuda_headers",
    hdrs = ["include/tinysplat/gaussian_2d_cuda.h"],
    includes = ["include"],
)

# CUDA kernels built with nvcc (no rules_cuda — compatible with Bazel 9).
genrule(
    name = "libgaussian_2d_cuda",
    srcs = [
        "gaussian_2d_cuda.cu",
        "include/tinysplat/gaussian_2d_cuda.h",
    ],
    outs = ["libgaussian_2d_cuda.a"],
    cmd = """
        set -e
        TMP=$$(mktemp -d)
        nvcc -std=c++17 -O3 -Xcompiler -fPIC -Xcompiler -std=c++17 \
          -I$$(dirname $(location gaussian_2d_cuda.cu))/include \
          -c $(location gaussian_2d_cuda.cu) -o $$TMP/gaussian_2d_cuda.o
        ar rcs $@ $$TMP/gaussian_2d_cuda.o
        rm -rf $$TMP
    """,
    tags = ["cuda"],
)

cc_import(
    name = "gaussian_2d_cuda",
    static_library = ":libgaussian_2d_cuda",
)
